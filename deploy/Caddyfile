# Host Caddy (same pattern as news.scuffedcrew.no).
# 1. DNS: A (or AAAA) for ow.scuffedcrew.no → this VPS
# 2. Point reverse_proxy at HOST_PORT from data/secrets.env (not always 3000)
# 3. Set REDIRECT_BASE_URL=https://ow.scuffedcrew.no in data/secrets.env
# 4. caddy reload / systemctl reload caddy

ow.scuffedcrew.no {
	encode zstd gzip

	# Cache-Control is set by the origin (cache_control_value). Do not add a
	# second Cache-Control header here. It would duplicate the origin policy
	# and freeze unhashed .js/.css/.wasm plus the HTML shell for a year.

	# Security headers. CSP is set by scuffed-server: enforcing
	# Content-Security-Policy by default, report-only when CSP_ENFORCE=0.
	# Do not add a second CSP here. Two policies intersect.
	# X-Content-Type-Options: nosniff is set by scuffed-server. Do not add it
	# here. A second header makes clients see the value twice.
	header X-Frame-Options "DENY"
	header Referrer-Policy "strict-origin-when-cross-origin"

	# Same-origin Nostr relay. Caddy strips /relay so the read gate sees /.
	# The gate (host 127.0.0.1:7777) requires NIP-42 AUTH before any REQ.
	# handle blocks are mutually exclusive, so the site catch-all is a handle
	# too. A bare reverse_proxy would also claim /relay.
	handle /relay* {
		uri strip_prefix /relay
		reverse_proxy 127.0.0.1:7777
	}

	# Keep compose bound to 127.0.0.1. Only Caddy is public.
	# reverse_proxy sets X-Forwarded-For to the real client. The app trusts
	# that header only from loopback and from TRUSTED_PROXIES (the Podman
	# network gateway this hop shows up as inside the container). See docs/deploy.md.
	handle {
		reverse_proxy 127.0.0.1:HOST_PORT_HERE
	}
}
