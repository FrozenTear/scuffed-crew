[Unit]
Description=Scuffed Crew database backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
# Root-only env file. It holds RESTIC_REPOSITORY (off-host URL) and
# RESTIC_PASSWORD_FILE (path to a root-owned mode-600 password file).
# Do not point this at data/secrets.env — that file is inside the snapshot.
EnvironmentFile=/etc/scuffed-crew/backup.env
ExecStart=/opt/scuffed-crew/scripts/backup.sh
TimeoutStartSec=600
