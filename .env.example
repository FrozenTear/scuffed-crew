# Scuffed Crew — Environment reference (power users)
#
# Novices: prefer ./scripts/install.sh which writes data/secrets.env for you.
# Copy: cp .env.example data/secrets.env && chmod 600 data/secrets.env

# ── SurrealDB ──────────────────────────────────────────────
SURREALDB_USER=root
SURREALDB_PASSWORD=          # REQUIRED — install.sh generates this
SURREALDB_NS=scuffed_crew
SURREALDB_DB=main
# Compose sets SURREALDB_URL=ws://surrealdb:8000 for the app container.

# ── Host publish port (loopback only) ──────────────────────
# install.sh picks a free port and persists it. Do not re-roll on every update.
HOST_PORT=3000

# ── Client IP for rate limits (required behind Podman) ─────
# Default trust is loopback only. Host Caddy proxies to 127.0.0.1:HOST_PORT;
# inside the container that hop is the compose-network gateway, not the
# browser. List those gateway IPs (comma-separated). Do not use 10.0.0.0/8
# or any whole private range.
# scripts/ensure-trusted-proxies.sh writes the live value into data/secrets.env
# when this is missing. Discover by hand with:
#   podman inspect <site-server> --format '{{range .NetworkSettings.Networks}}{{.Gateway}} {{end}}'
# TRUSTED_PROXIES=10.89.0.1,10.89.1.1

# ── WebSocket caps (strategy collab /api/strategy/ws) ──
# One global semaphore and one per-client-IP cap. The client IP is the
# trusted-proxy address (TRUSTED_PROXIES), not the raw peer, so a household
# behind Caddy is not one bucket. Defaults: 512 global, 32 concurrent
# sockets per IP (several players, multiple tabs each). A socket that has
# not sent JoinRoom within 10s is closed. Each socket holds a permit until
# it closes. Over the cap, the upgrade is rejected with Retry-After: 1
# (503 global, 429 per IP).
# WS_MAX_CONNECTIONS=512
# WS_MAX_PER_IP=32

# ── Public URL (OAuth redirects, CORS default) ─────────────
REDIRECT_BASE_URL=http://127.0.0.1:3000
# Comma-separated browser origins for CORS + strategy WS. Blank or unset
# falls back to REDIRECT_BASE_URL (F-API-004). Do not set an empty value
# thinking it means "allow all" — that used to 403 every browser WS.
# ALLOWED_ORIGINS=https://ow.scuffedcrew.no

# ── Encryption (Nostr keys etc.) ───────────────────────────
# openssl rand -base64 32
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=1
NOSTR_RELAY_URL=             # e.g. ws://strfry:7777 with --profile relay
NOSTR_CHALLENGE_SECRET=

# ── OAuth (optional) ───────────────────────────────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Cookies / production ───────────────────────────────────
# Release builds already use Secure cookies. Set for HSTS etc.:
# PRODUCTION=1
# SECURE_COOKIES=1

# ── Content-Security-Policy ────────────────────────────────
# Unset: the server sends Content-Security-Policy-Report-Only (console only).
# CSP_ENFORCE=1 switches that header to enforcing Content-Security-Policy.
# Nostr browser sockets follow NOSTR_RELAY_URL. Add other browser relay
# origins here (space or comma separated ws:// or wss:// URLs).
# CSP_EXTRA_CONNECT_SRC=
# Extra image origins for admin-set https backgrounds, logos, and covers
# that are not /uploads or the Discord/Google avatar CDNs.
# CSP_IMG_SRC=

# ── Emergency admin password reset only ────────────────────
# BOOTSTRAP_ADMIN_RESET=1
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=

# ── Logging ────────────────────────────────────────────────
RUST_LOG=info

# ── Public leaderboard cache ───────────────────────────────
# In-process TTL for GET /api/public/leaderboards, in seconds.
# Default 30. Values below 5 or above 300 are clamped. Blank or
# non-numeric values use 30. Uploads do not clear the cache; a new
# game shows up after this TTL. The cache is not shared across processes.
# Each entry lives for TTL times a factor in 0.8..=1.2, so keys do not
# all expire together. Past that window the previous board is served
# while one refresh runs. A board older than 10 TTLs waits for a scan.
# A finished scan hands its refresh slot to the oldest key waiting, so
# the slot does not sit idle. A skipped key's fallback backoff is jittered
# from 0.25x to 1x this TTL. One hot season stays about one TTL plus one
# scan old. This TTL and LEADERBOARD_CACHE_MAX_SCANS are the knobs.
# One scan per season covers every hero, metric, and limit.
# LEADERBOARD_CACHE_TTL_SECS=30
# How many leaderboard scans may run at once. Default 2. Values below 1
# or above 8 are clamped. Background refreshes may use at most one fewer
# slot than this (minimum 1) and do not wait. If none is free the key is
# queued and the next finished scan hands its slot over. Cold keys, and
# boards older than 10 TTLs, may use any free slot, including one a
# refresh cannot take. Total scans never exceed this cap.
# LEADERBOARD_CACHE_MAX_SCANS=2

# ── Matrix notifications (optional) ────────────────────────
# MATRIX_HOMESERVER_URL=
# MATRIX_BOT_ACCESS_TOKEN=
# MATRIX_OFFICER_ROOM_ID=
# MATRIX_GENERAL_ROOM_ID=

# ── Discord webhook notifications (optional) ───────────────
# Fire-and-forget parallel to Matrix. Missing URL = skip that channel.
# DISCORD_WEBHOOK_OFFICERS=https://discord.com/api/webhooks/...
# DISCORD_WEBHOOK_GENERAL=https://discord.com/api/webhooks/...
# Optional kill-switch: unset = enabled when either URL is set; 0/false/off disables.
# DISCORD_WEBHOOKS_ENABLED=1
