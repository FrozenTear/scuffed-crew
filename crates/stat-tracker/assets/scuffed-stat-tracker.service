[Unit]
Description=Scuffed Stat Tracker — OW2 personal stats capture daemon
After=graphical-session.target scuffed-stat-tracker-session.service
# Soft dependency: a failed session import must not keep the daemon down.
# graphical-session.target does not put WAYLAND_DISPLAY or DISPLAY on the
# user manager under Sway/Hyprland. The session oneshot writes session.env
# before this process is spawned.
Wants=scuffed-stat-tracker-session.service
PartOf=graphical-session.target
# A daemon that fails to start on every attempt (e.g. a broken config or a
# genuinely-stuck lock) must land in `failed` and stay visible — NOT loop on
# Restart=on-failure forever. Give up after 5 failures inside 5 minutes so the
# GUI/journal show a clear stopped state instead of a silent 300+ restart churn.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# ExecStart is rewritten at install to the absolute $PREFIX/bin binary.
# This placeholder matches the default prefix only; a custom PREFIX must
# go through install.sh or the unit keeps launching ~/.local/bin.
ExecStart=%h/.local/bin/scuffed-stat-tracker
# Refreshed by import-session-env.sh on each start. Overrides a stale
# user-manager import when the compositor socket name changes.
# The leading '-' means a missing file does not fail the unit.
EnvironmentFile=-%h/.config/scuffed-stat-tracker/session.env
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
# Yield CPU and disk to the game: OCR bursts run niced and in a
# low-weight cgroup so Overwatch keeps frame-pacing priority (H2).
Nice=10
CPUWeight=30
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# Sandbox. ProtectSystem=full is a no-op on user services, so this unit
# uses strict. When the user manager applies that mount namespace, the
# tree is read-only except ReadWritePaths (a leading '-' ignores a path
# that does not exist yet):
#   %h/.local/share/scuffed-stat-tracker  default data dir and tessdata
#   %h/.config/scuffed-stat-tracker       config.toml and session.env
#   %t                                    /run/user/$UID (Wayland, X11
#                                         display auth, D-Bus, PipeWire)
#
# PrivateTmp is omitted. It would hide /tmp/.X11-unix and break X11 capture.
# PrivateDevices is omitted, and DeviceAllow is left unset, so /dev/input
# stays reachable for evdev hotkeys (the user must be in the input group).
#
# A data_dir outside those three paths is not writable when the sandbox
# applies, including a custom directory under $HOME. install.sh writes
# scuffed-stat-tracker.service.d/data-dir.conf from an absolute data_dir
# in config.toml. Reinstall after changing it. If the directory is still
# not writable, the daemon logs the same drop-in and exits.
# Tessdata stays under the default data dir, not under a custom data_dir.
# --generate-tessdata (CLI or GUI, not this unit) also writes
# ~/.local/share/fonts. The GUI updater stages under /tmp and is not
# this unit. %h does not follow XDG_DATA_HOME or XDG_CONFIG_HOME.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=-%h/.local/share/scuffed-stat-tracker -%h/.config/scuffed-stat-tracker %t

[Install]
WantedBy=graphical-session.target
