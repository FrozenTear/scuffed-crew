[Unit]
Description=Import Wayland/X11 session environment for Scuffed Stat Tracker
After=graphical-session.target
Before=scuffed-stat-tracker.service
# Not enabled on its own. The daemon unit Wants= this oneshot so GUI Start
# and autostart re-read the compositor before the daemon is spawned.
# graphical-session.target does not import WAYLAND_DISPLAY or DISPLAY on
# Sway/Hyprland; this unit does.

[Service]
Type=oneshot
# ExecStart is rewritten at install to the absolute helper under $PREFIX.
# This placeholder matches the default prefix only.
ExecStart=%h/.local/lib/scuffed-stat-tracker/import-session-env.sh
# Same user-unit sandbox as the daemon, minus the capture exceptions.
# This oneshot only writes session.env under $HOME and talks to the user
# bus (%t). It does not open /dev/input or the X11 socket, so PrivateTmp
# is safe here. PrivateDevices stays off and DeviceAllow stays unset so
# this unit cannot grow a device policy the daemon unit would inherit
# by accident — the two units are separate, and the daemon must keep
# /dev/input.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=-%h/.config/scuffed-stat-tracker %t
PrivateTmp=yes
